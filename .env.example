# --- Servidor Express (server/) ---
# Puerto del servidor (por defecto 3001)
PORT=3001
# Archivo donde se guardan los datos (por defecto server/data/db.json)
# DATA_FILE=server/data/db.json
# Con "false" se oculta la lista de solicitudes de ejemplo en la página pública
# EJEMPLOS_DEMO=true
# Solo si el frontend y la API están en direcciones distintas (por defecto mismo origen)
# VITE_API_URL=http://localhost:3001
