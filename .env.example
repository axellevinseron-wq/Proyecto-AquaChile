# --- Servidor Express (server/) ---
# Puerto del servidor (por defecto 3001)
PORT=3001
# Archivo donde se guardan los datos (por defecto server/data/db.json)
# DATA_FILE=server/data/db.json
# Solo si el frontend y la API están en direcciones distintas (por defecto mismo origen)
# VITE_API_URL=http://localhost:3001
# URL pública del frontend usada para crear enlaces de invitación
APP_BASE_URL=http://localhost:5173
# Opcional: si no se configura, el administrador verá un enlace para compartirlo manualmente
RESEND_API_KEY=
RESEND_FROM="AquaChile <onboarding@resend.dev>"